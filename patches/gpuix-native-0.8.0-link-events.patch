+/// Remove a decoded data URL from GPUI's process asset cache and this window's
+/// sprite atlas. Callers must first prove that no retained `<img>` still uses
+/// the source; evicting a live image would make its next paint decode it again.
+pub(crate) fn release_data_url_image(
+    src: &str,
+    window: &mut gpui::Window,
+    cx: &mut gpui::App,
+) -> Option<bool> {
+    let (format, bytes) = decode_image_data_url(src)?;
+    let image = std::sync::Arc::new(gpui::Image::from_bytes(format, bytes));
+    #[cfg(any(test, feature = "test-support"))]
+    let cached = image.is_asset_cached(cx);
+    let render_image = image.clone().get_render_image(window, cx);
+    #[cfg(not(any(test, feature = "test-support")))]
+    let cached = render_image.is_some();
+    // This also removes an in-flight shared decoder task. The detached future
+    // may finish, but nothing can insert its result back into App.loading_assets.
+    image.remove_asset(cx);
+    if let Some(render_image) = render_image {
+        #[cfg(any(test, feature = "test-support"))]
+        let released_image = render_image.clone();
+        cx.drop_image(render_image, Some(window));
+        #[cfg(any(test, feature = "test-support"))]
+        assert!(
+            !window.has_image_atlas_entry(&released_image),
+            "released data-URL image remained in the current window atlas"
+        );
+    }
+    Some(cached)
