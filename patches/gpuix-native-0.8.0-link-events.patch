+#[derive(Clone)]
+pub struct LinkFocus {
+    pub handle: gpui::FocusHandle,
+    pub url: String,
+    pub position: Arc<parking_lot::Mutex<Option<(f32, f32)>>>,
+    pub focused: Arc<parking_lot::Mutex<bool>>,
+    pub on_focus_change: Arc<dyn Fn(bool, Option<(f32, f32)>)>,
+    pub focus_color: Hsla,
+    pub focus_border: Hsla,
+}
+
+pub type SharedLinkHover = Arc<parking_lot::Mutex<Option<usize>>>;
+
+fn register_link_hover_listener(
+    window: &mut Window,
+    layout: &TextLayout,
+    links: &[(Range<usize>, String)],
+    owner: usize,
+    hover_owner: Option<&SharedLinkHover>,
+    on_link_hover: &Arc<dyn Fn(Option<&str>, f32, f32)>,
+) {
+    use gpui::{DispatchPhase, MouseMoveEvent};
+
+    let (layout, links, hover_owner, on_link_hover) = (
+        layout.clone(),
+        links.to_vec(),
+        hover_owner.cloned(),
+        on_link_hover.clone(),
+    );
+    window.on_mouse_event(move |event: &MouseMoveEvent, phase, _window, _cx| {
+        if phase != DispatchPhase::Bubble {
+            return;
+        }
+        if !layout.bounds().contains(&event.position) {
+            if hover_owner
+                .as_ref()
+                .is_some_and(|state| state.lock().as_ref() == Some(&owner))
+            {
+                *hover_owner.as_ref().unwrap().lock() = None;
+                on_link_hover(None, f32::from(event.position.x), f32::from(event.position.y));
+            }
+            return;
+        }
+        let value = layout
+            .index_for_position(event.position)
+            .ok()
+            .and_then(|index| links.iter().find(|(range, _)| range.contains(&index)))
+            .map(|(_, payload)| payload.as_str());
+        if let Some(state) = &hover_owner {
+            *state.lock() = value.map(|_| owner);
+        }
+        on_link_hover(
+            value,
+            f32::from(event.position.x),
+            f32::from(event.position.y),
+        );
+    });
 }
 
