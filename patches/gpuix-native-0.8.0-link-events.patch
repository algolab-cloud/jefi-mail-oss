+pub(crate) fn data_url_image_cache_state(
+    src: &str,
+    window: &mut gpui::Window,
+    cx: &mut gpui::App,
+) -> Option<(bool, bool)> {
+    let (format, bytes) = decode_image_data_url(src)?;
+    let image = std::sync::Arc::new(gpui::Image::from_bytes(format, bytes));
+    let asset_cached = image.is_asset_cached(cx);
+    // `get_render_image` delegates to `Window::get_asset`, which starts a load
+    // on a miss. Probe it only after the non-mutating cache check succeeds.
+    let atlas_cached = asset_cached
+        && image
+            .get_render_image(window, cx)
+            .is_some_and(|render_image| window.has_image_atlas_entry(&render_image));
+    Some((asset_cached, atlas_cached))
+}
