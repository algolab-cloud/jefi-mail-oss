+pub fn link_urls(tree: &BlockTree, theme: &Theme) -> Vec<String> {
+    fn runs(out: &mut Vec<String>, inline: &[InlineRun], theme: &Theme) {
+        out.extend(
+            flatten_runs(inline, theme, FontWeight::NORMAL)
+                .links
+                .into_iter()
+                .map(|(_, url)| url),
+        );
+    }
+    fn blocks(out: &mut Vec<String>, nodes: &[Block], theme: &Theme) {
+        for block in nodes {
+            match block {
+                Block::Paragraph { runs: inline } | Block::Heading { runs: inline, .. } => {
+                    runs(out, inline, theme)
+                }
+                Block::BlockQuote { children } => blocks(out, children, theme),
+                Block::List { items, .. } => {
+                    items.iter().for_each(|item| blocks(out, item, theme))
+                }
+                Block::Table { header, rows, .. } => {
+                    header.iter().for_each(|cell| runs(out, cell, theme));
+                    rows
+                        .iter()
+                        .flatten()
+                        .for_each(|cell| runs(out, cell, theme));
+                }
+                Block::CodeBlock { .. } | Block::Rule => {}
+            }
+        }
+    }
+    let mut out = Vec::new();
+    blocks(&mut out, &tree.blocks, theme);
+    out
 }
 
