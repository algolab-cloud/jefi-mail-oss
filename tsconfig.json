{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@gpuix/react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // TypeScript 6+ no longer loads every @types package by default.
    "types": ["bun", "node"]
  },
  "include": ["src"]
}
